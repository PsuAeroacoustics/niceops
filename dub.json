{
	"name": "niceops",
	"dependencies": {
		"matplotlib-d": {"path": "./external/matplotlibd"},
		"numd": {"path": "./external/numd"}
	},
	"targetType": "executable",
	"excludedSourceFiles": ["source/niceops/wopwop2aam.d"],
	"preBuildCommands": [
		"mkdir $NICEOPS_PACKAGE_DIR/splinter_cpp/build ; cd $NICEOPS_PACKAGE_DIR/splinter_cpp/build ; cmake ../ -DBUILD_TYPE=$BUILD_TYPE; make",
		"mkdir $NICEOPS_PACKAGE_DIR/interpolator_cpp/build ; cd $NICEOPS_PACKAGE_DIR/interpolator_cpp/build ; cmake ../ -DBUILD_TYPE=$BUILD_TYPE; make"
	],
	"lflags": ["-L${NICEOPS_PACKAGE_DIR}/splinter_cpp/build", "-L${NICEOPS_PACKAGE_DIR}/splinter_cpp/build/external/splinter", "-L${NICEOPS_PACKAGE_DIR}/interpolator_cpp/build"],
	"lflags-posix": ["-lstdc++", "-lsplinter_cpp", "-lsplinter-static"],
	"libs": ["gmp", "mpfr", "netcdf", "interpolator"],
	"buildTypes": {
		"debug": {
			"buildOptions": ["debugMode", "debugInfo"],
			"buildRequirements": ["silenceWarnings"]
		},
		"debug-native": {
			"buildOptions": ["debugMode", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"buildRequirements": ["silenceWarnings"]
		},
		"debug-native-512": {
			"buildOptions": ["debugMode", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-mattr=-prefer-256-bit,prefer-mask-registers"],
			"versions": ["AVX_512F"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release": {
			"buildOptions": ["releaseMode", "inline", "optimize"],
			"dflags-ldc": ["-linkonce-templates"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native": {
			"buildOptions": ["releaseMode", "inline", "optimize"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native-512": {
			"buildOptions": ["releaseMode", "inline", "optimize"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates", "-mattr=-prefer-256-bit,+prefer-mask-registers"],
			"versions": ["AVX_512F"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native-dbinf": {
			"buildOptions": ["releaseMode", "inline", "optimize", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native-dbinf-512": {
			"buildOptions": ["releaseMode", "inline", "optimize", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates", "-mattr=-prefer-256-bit,+prefer-mask-registers"],
			"versions": ["AVX_512F"],
			"buildRequirements": ["silenceWarnings"]
		}
    }
}

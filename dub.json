{
	"name": "niceops",
	"dependencies": {
		"matplotlib-d": {"path": "./external/matplotlibd"},
		"numd": {"path": "./external/numd"}
	},
	"targetType": "executable",
	"excludedSourceFiles": ["source/niceops/wopwop2aam.d"],
	"preBuildCommands-posix": [
		"mkdir $NICEOPS_PACKAGE_DIR/splinter_cpp/build ; cd $NICEOPS_PACKAGE_DIR/splinter_cpp/build ; cmake ../ -DBUILD_TYPE=$BUILD_TYPE; make",
		"mkdir $NICEOPS_PACKAGE_DIR/interpolator_cpp/build ; cd $NICEOPS_PACKAGE_DIR/interpolator_cpp/build ; cmake ../ -DBUILD_TYPE=$BUILD_TYPE; make"
	],
	"preBuildCommands-windows": [
		"mkdir $NICEOPS_PACKAGE_DIR\\splinter_cpp\\build & cd $NICEOPS_PACKAGE_DIR\\splinter_cpp\\build & cmake ../ -DBUILD_TYPE=release & cmake --build .\\ --config=release",
		"mkdir $NICEOPS_PACKAGE_DIR\\interpolator_cpp\\build & cd $NICEOPS_PACKAGE_DIR\\interpolator_cpp\\build & cmake ../ -DBUILD_TYPE=release -DBOOST_INCLUDEDIR=$NICEOPS_PACKAGE_DIR\\interpolator_cpp\\external\\boost_1_81_0 & cmake --build .\\ --config=release"
	],
	"lflags-windows": [
		"/LIBPATH:${NICEOPS_PACKAGE_DIR}/splinter_cpp/build/Release",
		"/LIBPATH:${NICEOPS_PACKAGE_DIR}/splinter_cpp/build/external/splinter/Release",
		"/LIBPATH:${NICEOPS_PACKAGE_DIR}/interpolator_cpp/build/Release",
		"/LIBPATH:C:\\Program Files\\netCDF 4.9.1\\lib",
		"/LIBPATH:$GMP_LIB_DIR",
		"/NODEFAULTLIB:MSVCRT",
		"/NODEFAULTLIB:libucrt"
	],
	"lflags-posix": ["-L${NICEOPS_PACKAGE_DIR}/splinter_cpp/build", "-L${NICEOPS_PACKAGE_DIR}/splinter_cpp/build/external/splinter", "-L${NICEOPS_PACKAGE_DIR}/interpolator_cpp/build", "-lstdc++", "-lsplinter_cpp", "-lsplinter-static"],
	"libs-windows": ["splinter_cpp", "splinter-static", "libgmp-10", "libmpfr-4", "ucrt"],
	"libs": ["netcdf", "interpolator"],
	"buildTypes": {
		"debug": {
			"buildOptions": ["debugMode", "debugInfo"],
			"buildRequirements": ["silenceWarnings"]
		},
		"debug-native": {
			"buildOptions": ["debugMode", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"buildRequirements": ["silenceWarnings"]
		},
		"debug-native-512": {
			"buildOptions": ["debugMode", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-mattr=-prefer-256-bit,prefer-mask-registers"],
			"versions": ["AVX_512F"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release": {
			"buildOptions": ["releaseMode", "inline", "optimize"],
			"dflags-ldc": ["-linkonce-templates"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native": {
			"buildOptions": ["releaseMode", "inline", "optimize"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native-512": {
			"buildOptions": ["releaseMode", "inline", "optimize"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates", "-mattr=-prefer-256-bit,+prefer-mask-registers"],
			"versions": ["AVX_512F"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native-dbinf": {
			"buildOptions": ["releaseMode", "inline", "optimize", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates"],
			"buildRequirements": ["silenceWarnings"]
		},
		"release-native-dbinf-512": {
			"buildOptions": ["releaseMode", "inline", "optimize", "debugInfo"],
			"dflags": ["-mcpu=native"],
			"dflags-ldc": ["-linkonce-templates", "-mattr=-prefer-256-bit,+prefer-mask-registers"],
			"versions": ["AVX_512F"],
			"buildRequirements": ["silenceWarnings"]
		}
    }
}

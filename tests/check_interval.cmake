# Checks that a run's --phase_interval ends bracket its levels: row by row,
# LOWER <= LEVEL <= UPPER in the last column, with at least one row strictly
# inside, so that an interval collapsed onto the level everywhere fails.
# cmake -DLEVEL=a.csv -DLOWER=b.csv -DUPPER=c.csv -P tests/check_interval.cmake,
# from the source root.
foreach(name LEVEL LOWER UPPER)
  file(STRINGS "${${name}}" ${name}_rows)
endforeach()
list(LENGTH LEVEL_rows count)
foreach(name LOWER UPPER)
  list(LENGTH ${name}_rows n)
  if(NOT n EQUAL count)
    message(FATAL_ERROR "${${name}} has ${n} rows, ${LEVEL} ${count}")
  endif()
endforeach()
set(checked 0)
set(inside 0)
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
  list(GET LEVEL_rows ${i} row)
  if(NOT row MATCHES "^[-0-9]")
    continue()
  endif()
  foreach(name LEVEL LOWER UPPER)
    list(GET ${name}_rows ${i} line)
    string(REGEX REPLACE "^.*," "" value "${line}")
    string(STRIP "${value}" ${name}_value)
  endforeach()
  if(LOWER_value GREATER LEVEL_value OR LEVEL_value GREATER UPPER_value)
    message(FATAL_ERROR "row ${i}: ${LOWER_value} <= ${LEVEL_value} <= ${UPPER_value} fails")
  endif()
  if(LOWER_value LESS LEVEL_value AND LEVEL_value LESS UPPER_value)
    math(EXPR inside "${inside} + 1")
  endif()
  math(EXPR checked "${checked} + 1")
endforeach()
if(checked EQUAL 0)
  message(FATAL_ERROR "${LEVEL} has no levels")
endif()
if(inside EQUAL 0)
  message(FATAL_ERROR "every interval in ${LOWER} and ${UPPER} is the level itself")
endif()
message(STATUS "${checked} levels within their intervals, ${inside} strictly")

# Writes OUTPUT, a C++ source holding each kernel source in SOURCES (a list
# joined with '|') as a raw string, and gpu::kernel_source(), which looks one
# up by file name.  The GPU backends compile kernels from these at run time.
# The file is rewritten only when it changes, so an untouched kernel
# recompiles nothing.
set(content "// Generated by cmake/embed_kernels.cmake from src/gpu/kernels; do not edit.\n")
string(APPEND content "#include \"gpu/gpu.hpp\"\n\n#include <cstring>\n\nnamespace niceops::gpu {\n\nnamespace {\n\n")
string(APPEND content "struct Source\n{\n    const char* name;\n    const char* text;\n};\n\nconst Source sources[] = {\n")
string(REPLACE "|" ";" SOURCES "${SOURCES}")
foreach(file ${SOURCES})
  file(READ "${file}" text)
  get_filename_component(name "${file}" NAME)
  if(text MATCHES "\\)NICEOPS_KERNEL\"")
    message(FATAL_ERROR "${file} holds the raw string's delimiter")
  endif()
  string(APPEND content "    {\"${name}\", R\"NICEOPS_KERNEL(${text})NICEOPS_KERNEL\"},\n")
endforeach()
string(APPEND content "};\n\n} // namespace\n\nconst char* kernel_source(const std::string& name)\n{\n")
string(APPEND content "    for (const Source& s : sources)\n        if (name == s.name)\n            return s.text;\n")
string(APPEND content "    return nullptr;\n}\n\n} // namespace niceops::gpu\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
